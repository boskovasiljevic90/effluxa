generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                 String   @id @default(cuid())
  clerkOrgId         String   @unique
  subscription       String   @default("FREE")
  monthlyInvoiceCount Int     @default(0)
  usageResetAt       DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  uploadBatches      UploadBatch[]
  invoiceRows        InvoiceRow[]
  reconcileResults   ReconcileResult[]
  reconcileRuns      ReconcileRun[]
}

model UploadBatch {
  id        String   @id @default(cuid())
  orgId     String
  kind      String
  filename  String
  createdAt DateTime @default(now())

  org       Organization @relation(fields: [orgId], references: [id])
  rows      InvoiceRow[]
}

model InvoiceRow {
  id        String   @id @default(cuid())
  orgId     String
  batchId   String?
  raw       Json
  createdAt DateTime @default(now())

  org       Organization @relation(fields: [orgId], references: [id])
  batch     UploadBatch? @relation(fields: [batchId], references: [id])
  results   ReconcileResult[]
}

model ReconcileRun {
  id        String   @id @default(cuid())
  orgId     String
  createdAt DateTime @default(now())

  org       Organization @relation(fields: [orgId], references: [id])
  results   ReconcileResult[]
}

model ReconcileResult {
  id          String   @id @default(cuid())
  orgId       String
  runId       String?
  invoiceRowId String?
  status      String
  currency    String?
  paidTotal   Float?
  outstanding Float?
  createdAt   DateTime @default(now())

  org         Organization @relation(fields: [orgId], references: [id])
  run         ReconcileRun? @relation(fields: [runId], references: [id])
  invoiceRow  InvoiceRow? @relation(fields: [invoiceRowId], references: [id])

  @@index([orgId])
}
