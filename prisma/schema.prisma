generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id
  name      String   @default("Demo")
  plan      String   @default("free") // free | pro

  // Weekly usage limits for FREE plan
  usageResetAt          DateTime @default(now())
  weeklyInvoiceUploads  Int      @default(0)
  weeklyPaymentUploads  Int      @default(0)
  weeklyPriceListUploads Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  uploadBatches    UploadBatch[]
  invoiceRows      InvoiceRow[]
  paymentRows      PaymentRow[]
  priceListRows    PriceListRow[]
  reconcileRuns    ReconcileRun[]
  reconcileResults ReconcileResult[]
}

model UploadBatch {
  id        String   @id @default(cuid())
  orgId     String
  kind      String
  filename  String
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  invoiceRows   InvoiceRow[]
  paymentRows   PaymentRow[]
  priceListRows PriceListRow[]

  @@index([orgId, kind, createdAt])
}

model InvoiceRow {
  id        String   @id @default(cuid())
  orgId     String
  batchId   String?
  raw       Json
  createdAt DateTime @default(now())

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  batch UploadBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  reconcileResults ReconcileResult[]

  @@index([orgId, createdAt])
  @@index([batchId])
}

model PaymentRow {
  id        String   @id @default(cuid())
  orgId     String
  batchId   String?
  raw       Json
  createdAt DateTime @default(now())

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  batch UploadBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([batchId])
}

model PriceListRow {
  id        String   @id @default(cuid())
  orgId     String
  batchId   String?
  raw       Json
  createdAt DateTime @default(now())

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  batch UploadBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([batchId])
}

model ReconcileRun {
  id        String   @id @default(cuid())
  orgId     String
  summary   Json?
  createdAt DateTime @default(now())

  org     Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  results ReconcileResult[]

  @@index([orgId, createdAt])
}

model ReconcileResult {
  id           String   @id @default(cuid())
  orgId        String
  runId        String?
  invoiceRowId String?
  status       String
  currency     String?
  paidTotal    Float?
  outstanding  Float?
  matchReasons Json?
  createdAt    DateTime @default(now())

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  run        ReconcileRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  invoiceRow InvoiceRow?   @relation(fields: [invoiceRowId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([runId])
  @@index([invoiceRowId])
}
