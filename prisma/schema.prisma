generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OrganizationSubscription {
  orgId                String    @id
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  status               String    @default("inactive")
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model UploadBatch {
  id        String   @id @default(cuid())
  orgId     String
  kind      String // invoices | payments | price-list
  filename  String
  createdAt DateTime @default(now())

  invoices InvoiceRow[]
  payments PaymentRow[]
  prices   PriceListRow[]
}

model InvoiceRow {
  id           String    @id @default(cuid())
  orgId        String
  batchId      String
  invoiceNo    String?
  invoiceDate  DateTime?
  amount       Decimal?
  currency     String?
  counterparty String?
  reference    String?
  raw          Json
  createdAt    DateTime  @default(now())

  batch            UploadBatch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  reconcileResults ReconcileResult[]

  @@index([orgId])
  @@index([batchId])
}

model PaymentRow {
  id           String    @id @default(cuid())
  orgId        String
  batchId      String
  paymentRef   String?
  paymentDate  DateTime?
  amount       Decimal?
  currency     String?
  counterparty String?
  reference    String?
  raw          Json
  createdAt    DateTime  @default(now())

  batch UploadBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([batchId])
}

model PriceListRow {
  id        String   @id @default(cuid())
  orgId     String
  batchId   String
  sku       String?
  name      String?
  unitPrice Decimal?
  currency  String?
  raw       Json
  createdAt DateTime @default(now())

  batch UploadBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([batchId])
}

enum ReconcileStatus {
  UNPAID
  PARTIAL
  PAID
  OVERPAID
  MISMATCH
}

model ReconcileRun {
  id        String            @id @default(cuid())
  orgId     String
  createdAt DateTime          @default(now())
  summary   Json?
  results   ReconcileResult[]
}

model ReconcileResult {
  id    String       @id @default(cuid())
  orgId String
  runId String
  run   ReconcileRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  // Link to invoice row
  invoiceRowId String
  invoiceRow   InvoiceRow @relation(fields: [invoiceRowId], references: [id], onDelete: Cascade)

  status          ReconcileStatus
  matchedPayments Json? // array of paymentRowIds + amounts used
  matchReasons   Json?
  paidTotal       Decimal         @db.Decimal(18, 2)
  outstanding     Decimal         @db.Decimal(18, 2)
  currency        String?

  notes     String?
  createdAt DateTime @default(now())

  @@unique([runId, invoiceRowId])
  @@index([orgId, runId])
}
