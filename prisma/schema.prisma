generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FREE
  PRO
  BUSINESS
}

model User {
  id                                 String    @id @default(uuid())
  email                              String    @unique
  password                           String
  role                               Role      @default(FREE)
  weeklyUploadCount                  Int       @default(0)
  weeklyResetDate                    DateTime  @default(now())
  legacyPaymentCustomerId            String?
  legacyPaymentSubscriptionId        String?
  paddleCustomerId                   String?
  paddleSubscriptionId               String?
  subscriptionEndDate                DateTime?
  subscriptionStatus                 String    @default("inactive")
  complimentaryAgencyAccessUntil     DateTime?
  complimentaryAgencyAccessGrantedAt DateTime?
  complimentaryAgencyAccessRevokedAt DateTime?
  complimentaryAgencyAccessReason    String?
  referralCode                       String?   @unique
  referredByCode                     String?
  preferredLanguage                  String    @default("en")
  companyName                        String?
  reportFooter                       String?
  notificationLastSeenAt             DateTime?
  emailMonthlySummary                Boolean   @default(true)
  emailProductUpdates                Boolean   @default(true)
  emailAuditReminders                Boolean   @default(true)
  uploads                            Upload[]
  clients                            Client[]
  createdAt                          DateTime  @default(now())

  @@index([referredByCode])
}

model Upload {
  id                     String          @id @default(uuid())
  userId                 String
  fileUrl                String
  parsedData             Json?
  summary                String?
  internalNote           String?
  shareToken             String?         @unique
  unlocked               Boolean         @default(false)
  unlockedAt             DateTime?
  legacyPaymentReference String?
  checkoutTransactionId  String?
  clientId               String?
  createdAt              DateTime        @default(now())
  user                   User            @relation(fields: [userId], references: [id])
  client                 Client?         @relation(fields: [clientId], references: [id])
  controlActions         ControlAction[]
  findingReviews         FindingReview[]
}

model AuditJob {
  id               String    @id @default(uuid())
  workspaceOwnerId String
  createdByUserId  String
  clientId         String?
  fileName         String
  fileType         String?
  fileSize         Int
  fileHash         String
  idempotencyKey   String
  language         String    @default("English")
  status           String    @default("QUEUED")
  attemptCount     Int       @default(0)
  maxAttempts      Int       @default(3)
  sourceBytes      Bytes?
  reportId         String?
  lastError        String?
  nextAttemptAt    DateTime?
  lockedAt         DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([workspaceOwnerId, idempotencyKey])
  @@index([workspaceOwnerId, status, createdAt])
  @@index([status, nextAttemptAt])
  @@index([reportId])
}

model ControlAction {
  id                String    @id @default(uuid())
  reportId          String
  workspaceOwnerId  String
  createdByUserId   String?
  findingId         String
  findingTitle      String
  ruleId            String?
  findingCategory   String?
  findingSeverity   String
  recommendedAction String
  evidence          Json
  quantifiedAmount  Float?
  currency          String    @default("EUR")
  status            String    @default("OPEN")
  ownerEmail        String?
  dueDate           DateTime?
  outcomeNote       String?
  resolvedAmount    Float?
  lastReminderAt    DateTime?
  lastReminderKind  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  report Upload @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, findingId])
  @@index([workspaceOwnerId, status])
  @@index([reportId, status])
  @@index([status, dueDate, lastReminderAt])
}

model FindingReview {
  id               String   @id @default(uuid())
  reportId         String
  workspaceOwnerId String
  reviewerUserId   String
  findingId        String
  verdict          String
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  report Upload @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, findingId, reviewerUserId])
  @@index([workspaceOwnerId, verdict])
  @@index([reportId, findingId])
  @@index([reviewerUserId, createdAt])
}

model Event {
  id        String   @id @default(uuid())
  type      String
  userId    String?
  reportId  String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String?
  email     String
  subject   String?
  message   String
  source    String   @default("general_support")
  status    String   @default("NEW")
  createdAt DateTime @default(now())

  @@index([source, status, createdAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model TeamMember {
  id        String   @id @default(uuid())
  ownerId   String
  email     String
  status    String   @default("INVITED")
  invitedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([ownerId, email])
}

model Client {
  id         String   @id @default(uuid())
  ownerId    String
  name       String
  notes      String?
  shareToken String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner   User     @relation(fields: [ownerId], references: [id])
  uploads Upload[]

  @@unique([ownerId, name])
}
