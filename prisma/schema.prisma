generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                    String   @id
  plan                  String   @default("free")

  weeklyInvoiceCount    Int      @default(0)
  weeklyPaymentCount    Int      @default(0)
  weeklyPriceCount      Int      @default(0)
  weeklyReconcileCount  Int      @default(0)

  usageResetAt          DateTime @default(now())

  stripeCustomerId      String?
  stripeSubscriptionId  String?
  subscriptionStatus    String   @default("free")

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model UploadBatch {
  id        String   @id @default(cuid())
  orgId     String
  kind      String
  filename  String
  createdAt DateTime @default(now())
}

model InvoiceRow {
  id        String   @id @default(cuid())
  orgId     String
  batchId   String?
  raw       Json
  createdAt DateTime @default(now())
}

model PaymentRow {
  id        String   @id @default(cuid())
  orgId     String
  batchId   String?
  raw       Json
  createdAt DateTime @default(now())
}

model PriceListRow {
  id        String   @id @default(cuid())
  orgId     String
  batchId   String?
  raw       Json
  createdAt DateTime @default(now())
}

model ReconcileRun {
  id        String   @id @default(cuid())
  orgId     String
  summary   Json?
  createdAt DateTime @default(now())

  @@index([orgId])
}

model ReconcileResult {
  id           String   @id @default(cuid())
  orgId        String
  runId        String?
  invoiceRowId String?
  status       String
  currency     String?
  paidTotal    Float?
  outstanding  Float?
  createdAt    DateTime @default(now())

  @@index([orgId])
}
