type Kind = "invoices" | "payments" | "price-list";

function normKey(s: string) {
  return (s || "")
    .toLowerCase()
    .trim()
    .replace(/[\s\-_#()]/g, "")
    .replace(/[^a-z0-9]/g, "");
}

function pickKey(row: Record<string, any>, patterns: RegExp[]) {
  const keys = Object.keys(row || {});
  for (const k of keys) {
    const nk = normKey(k);
    for (const p of patterns) {
      if (p.test(nk)) return k;
    }
  }
  return null;
}

function toText(v: any) {
  if (v === null || v === undefined) return null;
  const s = String(v).trim();
  return s === "" ? null : s;
}

function toNumberLike(v: any) {
  if (v === null || v === undefined || v === "") return null;
  if (typeof v === "number") return v;

  const s0 = String(v).trim();
  if (!s0) return null;

  const s1 = s0.replace(/[^\d,.\-]/g, "");
  const lastComma = s1.lastIndexOf(",");
  const lastDot = s1.lastIndexOf(".");
  let s2 = s1;

  if (lastComma !== -1 && lastDot !== -1) {
    if (lastComma > lastDot) s2 = s1.replace(/\./g, "").replace(",", ".");
    else s2 = s1.replace(/,/g, "");
  } else if (lastComma !== -1) {
    s2 = s1.replace(/\./g, "").replace(",", ".");
  } else {
    s2 = s1.replace(/,/g, "");
  }

  const n = Number(s2);
  return Number.isFinite(n) ? n : null;
}

function toDate(v: any) {
  if (v === null || v === undefined || v === "") return null;

  if (v instanceof Date && !isNaN(v.getTime())) return v;

  if (typeof v === "number" && Number.isFinite(v)) {
    const asInt = Math.trunc(v);
    const s = String(asInt);
    if (/^\d{8}$/.test(s)) {
      const first4 = Number(s.slice(0, 4));
      if (first4 >= 1900 && first4 <= 2100) {
        const y = first4;
        const m = Number(s.slice(4, 6));
        const d = Number(s.slice(6, 8));
        const dt = new Date(Date.UTC(y, m - 1, d));
        return isNaN(dt.getTime()) ? null : dt;
      } else {
        const d = Number(s.slice(0, 2));
        const m = Number(s.slice(2, 4));
        const y = Number(s.slice(4, 8));
        const dt = new Date(Date.UTC(y, m - 1, d));
        return isNaN(dt.getTime()) ? null : dt;
      }
    }

    if (v > 20000 && v < 60000) {
      const excelEpoch = Date.UTC(1899, 11, 30);
      const dt = new Date(excelEpoch + v * 24 * 60 * 60 * 1000);
      return isNaN(dt.getTime()) ? null : dt;
    }
  }

  const s = String(v).trim();
  if (!s) return null;

  if (/^\d{8}$/.test(s)) {
    const first4 = Number(s.slice(0, 4));
    if (first4 >= 1900 && first4 <= 2100) {
      const y = first4;
      const m = Number(s.slice(4, 6));
      const d = Number(s.slice(6, 8));
      const dt = new Date(Date.UTC(y, m - 1, d));
      return isNaN(dt.getTime()) ? null : dt;
    } else {
      const d = Number(s.slice(0, 2));
      const m = Number(s.slice(2, 4));
      const y = Number(s.slice(4, 8));
      const dt = new Date(Date.UTC(y, m - 1, d));
      return isNaN(dt.getTime()) ? null : dt;
    }
  }

  const d = new Date(s);
  return isNaN(d.getTime()) ? null : d;
}

function mapInvoiceRow(row: Record<string, any>) {
  const kNo = pickKey(row, [/^invoicen(o|um|umber)$/, /^invno$/, /^invoiceid$/, /^invoice#$/, /^billno$/, /^documentno$/]);
  const kAmt = pickKey(row, [/^amount$/, /^total$/, /^invoicetotal$/, /^grandtotal$/, /^balance$/, /^due$/, /^nettotal$/]);
  const kCur = pickKey(row, [/^currency$/, /^curr$/, /^ccy$/]);
  const kDate = pickKey(row, [/^invoicedate$/, /^date$/, /^issuedate$/, /^billdate$/]);

  return {
    invoiceNo: kNo ? toText(row[kNo]) : null,
    amount: kAmt ? toNumberLike(row[kAmt]) : null,
    currency: kCur ? toText(row[kCur]) : null,
    invoiceDate: kDate ? toDate(row[kDate]) : null,
  };
}

function mapPaymentRow(row: Record<string, any>) {
  const kRef = pickKey(row, [/^reference$/, /^ref$/, /^description$/, /^memo$/, /^details$/, /^note$/, /^paymentreference$/]);
  const kAmt = pickKey(row, [/^amount$/, /^paid$/, /^paymentamount$/, /^total$/, /^value$/]);
  const kCur = pickKey(row, [/^currency$/, /^curr$/, /^ccy$/]);
  const kDate = pickKey(row, [/^paymentdate$/, /^date$/, /^valuedate$/, /^posteddate$/, /^transactiondate$/]);

  return {
    reference: kRef ? toText(row[kRef]) : null,
    amount: kAmt ? toNumberLike(row[kAmt]) : null,
    currency: kCur ? toText(row[kCur]) : null,
    paymentDate: kDate ? toDate(row[kDate]) : null,
  };
}

function mapPriceRow(row: Record<string, any>) {
  const kSku = pickKey(row, [/^sku$/, /^item$/, /^itemcode$/, /^productcode$/, /^code$/]);
  const kName = pickKey(row, [/^name$/, /^product$/, /^description$/, /^itemname$/]);
  const kPrice = pickKey(row, [/^price$/, /^unitprice$/, /^amount$/, /^rate$/, /^unitprice$/]);
  const kCur = pickKey(row, [/^currency$/, /^curr$/, /^ccy$/]);

  return {
    sku: kSku ? toText(row[kSku]) : null,
    name: kName ? toText(row[kName]) : null,
    unitPrice: kPrice ? toNumberLike(row[kPrice]) : null,
    currency: kCur ? toText(row[kCur]) : null,
  };
}

async function getClerkClientSafe(): Promise<any> {
  const cc: any = clerkClientImport as any;
  if (typeof cc === "function") return await cc();
  return cc;
}

async function getEffectiveOrgId(userId: string, orgId: string | null) {
  if (orgId) return orgId;

  const client = await getClerkClientSafe();

  if (client?.users?.getOrganizationMembershipList) {
    const memberships = await client.users.getOrganizationMembershipList({ userId });
    return memberships?.data?.[0]?.organization?.id ?? null;
  }

  if (client?.organizationMemberships?.getOrganizationMembershipList) {
    const memberships = await client.organizationMemberships.getOrganizationMembershipList({ userId });
    return memberships?.data?.[0]?.organization?.id ?? null;
  }

  return null;
}

function extLower(name: string) {
  const i = name.lastIndexOf(".");
  return i === -1 ? "" : name.slice(i + 1).toLowerCase();
}

function tryFindCurrency(text: string) {
  const t = text.toUpperCase();
  const list = ["RSD", "EUR", "USD", "GBP", "CHF", "AED", "SAR", "NOK", "SEK", "DKK", "PLN", "HUF", "CZK", "RON", "BGN", "TRY"];
  for (const c of list) {
    if (t.includes(c)) return c;
  }
  return null;
}

function firstNonEmptyLine(text: string) {
  return (text || "")
    .split(/\r?\n/)
    .map((l) => l.trim())
    .find((l) => l.length > 0) ?? null;
}

function extractDateFromText(text: string) {
  const t = text || "";
  const m1 = t.match(/\b(\d{4})[-/.](\d{2})[-/.](\d{2})\b/); // YYYY-MM-DD
  if (m1) return toDate(`${m1[1]}-${m1[2]}-${m1[3]}`);
  const m2 = t.match(/\b(\d{2})[-/.](\d{2})[-/.](\d{4})\b/); // DD.MM.YYYY
  if (m2) return toDate(`${m2[1]}${m2[2]}${m2[3]}`);
  return null;
}

function extractInvoiceNoFromText(text: string) {
  const t = text || "";
  const patterns = [
    /invoice\s*(no|nr|number)\s*[:#]?\s*([A-Z0-9\-\/]+)/i,
    /rechnung\s*(nr|nummer)\s*[:#]?\s*([A-Z0-9\-\/]+)/i,
    /faktura\s*(br|broj|no|nr)\s*[:#]?\s*([A-Z0-9\-\/]+)/i,
  ];
  for (const p of patterns) {
    const m = t.match(p);
    if (m && m[2]) return m[2].trim();
  }
  return null;
}

function extractAmountNearKeywords(text: string) {
  const t = text || "";
  const candidates = [
    /total\s*(due)?\s*[:]?[\s]*([0-9][0-9.,\s]+)/i,
    /grand\s*total\s*[:]?[\s]*([0-9][0-9.,\s]+)/i,
    /ukupno\s*[:]?[\s]*([0-9][0-9.,\s]+)/i,
    /iznos\s*za\s*uplatu\s*[:]?[\s]*([0-9][0-9.,\s]+)/i,
    /betrag\s*[:]?[\s]*([0-9][0-9.,\s]+)/i,
  ];
  for (const re of candidates) {
    const m = t.match(re);
    const val = m?.[2] ?? m?.[1];
    const n = toNumberLike(val);
    if (n !== null) return n;
  }

  // fallback: last “big-looking” number
  const nums = (t.match(/[0-9]{1,3}(?:[.,\s][0-9]{3})*(?:[.,][0-9]{2})/g) || [])
    .map((s) => toNumberLike(s))
    .filter((x) => typeof x === "number") as number[];
  if (!nums.length) return null;
  return nums.sort((a, b) => Math.abs(b) - Math.abs(a))[0];
}

async function parsePdfToText(buf: Buffer) {
  const data = await pdfParse(buf);
  const text = (data?.text || "").trim();
  if (!text) throw new Error("PDF has no extractable text (might be scanned).");
  return text;
}

async function processSingleFile(params: {
  effectiveOrgId: string;
  kind: Kind;
  filename: string;
  buf: Buffer;
  batchId: string;
}) {
  const { effectiveOrgId, kind, filename, buf, batchId } = params;
  const ext = extLower(filename);

  // PDF
  if (ext === "pdf") {
    const text = await parsePdfToText(buf);
    const currency = tryFindCurrency(text);
    const invoiceNo = extractInvoiceNoFromText(text);
    const invoiceDate = extractDateFromText(text);
    const vendor = firstNonEmptyLine(text);
    const amount = extractAmountNearKeywords(text);

    if (kind === "invoices") {
      await prisma.invoiceRow.create({
        data: {
          orgId: effectiveOrgId,
          batchId,
          raw: { source: "pdf", text },
          invoiceNo: invoiceNo,
          invoiceDate,
          currency,
          amount,
          vendor: vendor,
        } as any,
      });
      return { rows: 1, mode: "pdf" as const };
    }

    // Payments / Price list PDFs: keep best-effort minimal (do not block user)
    if (kind === "payments") {
      await prisma.paymentRow.create({
        data: {
          orgId: effectiveOrgId,
          batchId,
          raw: { source: "pdf", text },
          reference: invoiceNo || null,
          currency,
          amount,
          paymentDate: invoiceDate,
        } as any,
      });
      return { rows: 1, mode: "pdf" as const };
    }

    if (kind === "price-list") {
      await prisma.priceListRow.create({
        data: {
          orgId: effectiveOrgId,
          batchId,
          raw: { source: "pdf", text },
          sku: invoiceNo || null,
          name: vendor,
          currency,
          unitPrice: amount,
        } as any,
      });
      return { rows: 1, mode: "pdf" as const };
    }
  }

  // Tabular (CSV/TSV/XLSX)
  const rows = await parseTabular(buf, filename);
  if (!rows || rows.length === 0) throw new Error("No rows found");

  if (kind === "invoices") {
    const data = rows.map((r: any) => ({
      orgId: effectiveOrgId,
      batchId,
      raw: r,
      ...mapInvoiceRow(r),
    }));
    await prisma.invoiceRow.createMany({ data });
  }

  if (kind === "payments") {
    const data = rows.map((r: any) => ({
      orgId: effectiveOrgId,
      batchId,
      raw: r,
      ...mapPaymentRow(r),
    }));
    await prisma.paymentRow.createMany({ data });
  }

  if (kind === "price-list") {
    const data = rows.map((r: any) => ({
      orgId: effectiveOrgId,
      batchId,
      raw: r,
      ...mapPriceRow(r),
    }));
    await prisma.priceListRow.createMany({ data });
  }

  return { rows: rows.length, mode: "tabular" as const, headersDetected: Object.keys(rows[0] || {}) };
}

export async function handleUpload(req: Request, kind: Kind) {
  try {
    const { userId, orgId } = await auth();
    if (!userId) return NextResponse.json({ error: "Not signed in" }, { status: 401 });

    const effectiveOrgId = await getEffectiveOrgId(userId, orgId ?? null);
    if (!effectiveOrgId) {
      return NextResponse.json(
        { error: "Missing org", hint: "Switch to an organization (not Personal) in the UI and retry." },
        { status: 400 }
      );
    }

    const form = await req.formData();
    const file = form.get("file");
    if (!(file instanceof File)) return NextResponse.json({ error: "Missing file" }, { status: 400 });

    const buf = Buffer.from(await file.arrayBuffer());
    const ext = extLower(file.name);

    const batch = await prisma.uploadBatch.create({
      data: {
        orgId: effectiveOrgId,
        kind,
        filename: file.name,
      },
    });

    // ZIP: unpack in-memory and process every file inside as the same "kind"
    if (ext === "zip") {
      const zip = await JSZip.loadAsync(buf);
      let totalRows = 0;
      const processed: Array<{ name: string; rows: number; mode: string }> = [];

      const entries = Object.values(zip.files).filter((f) => !f.dir);
      if (!entries.length) {
        return NextResponse.json({ error: "ZIP is empty" }, { status: 400 });
      }

      for (const f of entries) {
        const name = f.name.split("/").pop() || f.name;
        const e = extLower(name);
        // allow only known types
        if (!["csv", "tsv", "xlsx", "xls", "pdf"].includes(e)) continue;

        const innerBuf = Buffer.from(await f.async("nodebuffer"));
        const r = await processSingleFile({
          effectiveOrgId,
          kind,
          filename: name,
          buf: innerBuf,
          batchId: batch.id,
        });
        totalRows += r.rows;
        processed.push({ name, rows: r.rows, mode: r.mode });
      }

      if (!processed.length) {
        return NextResponse.json({ error: "ZIP has no supported files (csv/tsv/xlsx/pdf)" }, { status: 400 });
      }

      return NextResponse.json({
        ok: true,
        batchId: batch.id,
        kind,
        filename: file.name,
        rows: totalRows,
        processed,
        orgId: effectiveOrgId,
      });
    }

    // Normal single file (PDF or tabular)
    const r = await processSingleFile({
      effectiveOrgId,
      kind,
      filename: file.name,
      buf,
      batchId: batch.id,
    });

    return NextResponse.json({
      ok: true,
      batchId: batch.id,
      kind,
      filename: file.name,
      rows: r.rows,
      headersDetected: (r as any).headersDetected ?? null,
      orgId: effectiveOrgId,
      mode: r.mode,
    });
  } catch (e: any) {
    return NextResponse.json({ error: "Internal error", message: e?.message ?? String(e) }, { status: 500 });
  }
}
