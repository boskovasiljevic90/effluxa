export const runtime = "nodejs";
export const dynamic = "force-dynamic";

type Kind = "invoices" | "payments" | "price-list";

function normKey(s: string) {
  return (s || "")
    .toLowerCase()
    .trim()
    .replace(/[\s\-_#()]/g, "")
    .replace(/[^a-z0-9]/g, "");
}

function pickKey(row: Record<string, any>, patterns: RegExp[]) {
  const keys = Object.keys(row || {});
  for (const k of keys) {
    const nk = normKey(k);
    for (const p of patterns) {
      if (p.test(nk)) return k;
    }
  }
  return null;
}

function toText(v: any) {
  if (v === null || v === undefined) return null;
  const s = String(v).trim();
  return s === "" ? null : s;
}

function toNumberLike(v: any) {
  if (v === null || v === undefined || v === "") return null;
  if (typeof v === "number") return v;

  const s0 = String(v).trim();
  if (!s0) return null;

  const s1 = s0.replace(/[^\d,.\-]/g, "");
  const lastComma = s1.lastIndexOf(",");
  const lastDot = s1.lastIndexOf(".");
  let s2 = s1;

  if (lastComma !== -1 && lastDot !== -1) {
    if (lastComma > lastDot) s2 = s1.replace(/\./g, "").replace(",", ".");
    else s2 = s1.replace(/,/g, "");
  } else if (lastComma !== -1) {
    s2 = s1.replace(/\./g, "").replace(",", ".");
  } else {
    s2 = s1.replace(/,/g, "");
  }

  const n = Number(s2);
  return Number.isFinite(n) ? n : null;
}

function toDate(v: any) {
  if (v === null || v === undefined || v === "") return null;
  if (v instanceof Date && !isNaN(v.getTime())) return v;

  // Handle Excel date int like 23012026 (ddMMyyyy) which you have in your samples
  if (typeof v === "number") {
    const s = String(v);
    if (s.length === 8) {
      const dd = Number(s.slice(0, 2));
      const mm = Number(s.slice(2, 4));
      const yyyy = Number(s.slice(4, 8));
      if (dd >= 1 && dd <= 31 && mm >= 1 && mm <= 12 && yyyy >= 1900) {
        const d = new Date(Date.UTC(yyyy, mm - 1, dd));
        return isNaN(d.getTime()) ? null : d;
      }
    }
  }

  const s = String(v).trim();
  if (!s) return null;

  // Try yyyy-mm-dd etc.
  const d = new Date(s);
  return isNaN(d.getTime()) ? null : d;
}

function mapInvoiceRow(row: Record<string, any>) {
  const kNo = pickKey(row, [/^invoicen(o|um|umber)$/, /^invno$/, /^invoiceid$/, /^invoice#$/, /^billno$/, /^documentno$/]);
  const kAmt = pickKey(row, [/^amount$/, /^total$/, /^invoicetotal$/, /^grandtotal$/, /^balance$/, /^due$/, /^nettotal$/]);
  const kCur = pickKey(row, [/^currency$/, /^curr$/, /^ccy$/]);
  const kDate = pickKey(row, [/^invoicedate$/, /^date$/, /^issuedate$/, /^billdate$/]);

  return {
    invoiceNo: kNo ? toText(row[kNo]) : null,
    amount: kAmt ? toNumberLike(row[kAmt]) : null,
    currency: kCur ? toText(row[kCur]) : null,
    invoiceDate: kDate ? toDate(row[kDate]) : null,
  };
}

function mapPaymentRow(row: Record<string, any>) {
  const kRef = pickKey(row, [/^reference$/, /^ref$/, /^description$/, /^memo$/, /^details$/, /^note$/, /^paymentreference$/]);
  const kAmt = pickKey(row, [/^amount$/, /^paid$/, /^paymentamount$/, /^total$/, /^value$/]);
  const kCur = pickKey(row, [/^currency$/, /^curr$/, /^ccy$/]);
  const kDate = pickKey(row, [/^paymentdate$/, /^date$/, /^valuedate$/, /^posteddate$/, /^transactiondate$/, /^payment_date$/]);

  return {
    reference: kRef ? toText(row[kRef]) : null,
    amount: kAmt ? toNumberLike(row[kAmt]) : null,
    currency: kCur ? toText(row[kCur]) : null,
    paymentDate: kDate ? toDate(row[kDate]) : null,
  };
}

function mapPriceRow(row: Record<string, any>) {
  const kSku = pickKey(row, [/^sku$/, /^item$/, /^itemcode$/, /^productcode$/, /^code$/]);
  const kName = pickKey(row, [/^name$/, /^product$/, /^description$/, /^itemname$/]);
  const kPrice = pickKey(row, [/^unitprice$/, /^price$/, /^amount$/, /^rate$/, /^unit_price$/]);
  const kCur = pickKey(row, [/^currency$/, /^curr$/, /^ccy$/]);

  return {
    sku: kSku ? toText(row[kSku]) : null,
    name: kName ? toText(row[kName]) : null,
    unitPrice: kPrice ? toNumberLike(row[kPrice]) : null,
    currency: kCur ? toText(row[kCur]) : null,
  };
}

async function getClerkClientSafe(): Promise<any> {
  const cc: any = clerkClientImport as any;
  if (typeof cc === "function") return await cc();
  return cc;
}

async function getEffectiveOrgId(userId: string, orgId: string | null) {
  if (orgId) return orgId;

  const client = await getClerkClientSafe();

  if (client?.users?.getOrganizationMembershipList) {
    const memberships = await client.users.getOrganizationMembershipList({ userId });
    return memberships?.data?.[0]?.organization?.id ?? null;
  }

  if (client?.organizationMemberships?.getOrganizationMembershipList) {
    const memberships = await client.organizationMemberships.getOrganizationMembershipList({ userId });
    return memberships?.data?.[0]?.organization?.id ?? null;
  }

  return null;
}

// ---- PDF parse: safe loader for Turbopack (NO default import) ----
async function parsePdfText(buffer: Buffer): Promise<string> {
  const mod: any = await import("pdf-parse");
  const fn = mod?.default ?? mod; // pdf-parse ESM/CJS safe
  const res = await fn(buffer);
  return (res?.text ?? "").trim();
}

// Very simple invoice extraction MVP from PDF text.
// We store raw text + best-effort fields so reconciliation can still work.
function mapInvoiceFromPdfText(text: string, filename: string) {
  // invoice number guess: look for "Invoice" line or "Faktura" etc.
  const lines = text.split(/\r?\n/).map((l) => l.trim()).filter(Boolean);
  const joined = lines.join(" ");

  const invNoMatch =
    joined.match(/invoice\s*(no|number)?\s*[:#]?\s*([A-Z0-9\-\/]+)/i) ||
    joined.match(/faktura\s*(br|broj)?\s*[:#]?\s*([A-Z0-9\-\/]+)/i);

  const currencyMatch = joined.match(/\b(RSD|EUR|USD|GBP|CHF)\b/i);
  const amountMatch =
    joined.match(/total\s*[:]?[\s]*([0-9\.,]+)\s*(RSD|EUR|USD|GBP|CHF)?/i) ||
    joined.match(/ukupno\s*[:]?[\s]*([0-9\.,]+)\s*(RSD|EUR|USD|GBP|CHF)?/i);

  const invoiceNo = invNoMatch ? invNoMatch[2] : null;
  const currency = (amountMatch?.[2] || currencyMatch?.[1] || null) ? String(amountMatch?.[2] || currencyMatch?.[1]).toUpperCase() : null;
  const amount = amountMatch ? toNumberLike(amountMatch[1]) : null;

  return {
    invoiceNo,
    amount,
    currency,
    invoiceDate: null,
    raw: {
      __type: "pdf",
      __filename: filename,
      text,
    },
  };
}

async function parseAnyToRows(fileName: string, buf: Buffer, kind: Kind): Promise<Record<string, any>[]> {
  const lower = fileName.toLowerCase();

  // ZIP: parse nested files
  if (lower.endsWith(".zip")) {
    const zip = await JSZip.loadAsync(buf);
    const out: Record<string, any>[] = [];

    for (const fname of Object.keys(zip.files)) {
      const f = zip.files[fname];
      if (f.dir) continue;

      const data = Buffer.from(await f.async("nodebuffer"));

      const nested = await parseAnyToRows(fname, data, kind);
      for (const r of nested) out.push({ __source: fname, ...r });
    }
    return out;
  }

  // PDF: only allowed for invoices (for now)
  if (lower.endsWith(".pdf")) {
    if (kind !== "invoices") {
      throw new Error("PDF is only supported for invoices in the current version.");
    }
    const text = await parsePdfText(buf);
    if (!text) throw new Error("PDF parse failed: no text extracted.");
    return [mapInvoiceFromPdfText(text, fileName)];
  }

  // CSV/TSV/XLSX
  return await parseTabular(buf, fileName);
}

export async function handleUpload(req: Request, kind: Kind) {
  try {
    const { userId, orgId } = await auth();
    if (!userId) return NextResponse.json({ error: "Not signed in" }, { status: 401 });

    const effectiveOrgId = await getEffectiveOrgId(userId, orgId ?? null);
    if (!effectiveOrgId) {
      return NextResponse.json(
        { error: "Missing org", hint: "Switch to an organization (not Personal) in the UI and retry." },
        { status: 400 }
      );
    }

    const form = await req.formData();
    const file = form.get("file");
    if (!(file instanceof File)) return NextResponse.json({ error: "Missing file" }, { status: 400 });

    const buf = Buffer.from(await file.arrayBuffer());
    const rows = await parseAnyToRows(file.name, buf, kind);

    if (!rows || rows.length === 0) {
      return NextResponse.json({ error: "No rows found" }, { status: 400 });
    }

    const headersDetected = Object.keys(rows[0] || {});

    const batch = await prisma.uploadBatch.create({
      data: {
        orgId: effectiveOrgId,
        kind,
        filename: file.name,
      },
    });

    if (kind === "invoices") {
      const data = rows.map((r: any) => {
        // PDF row already mapped
        if (r?.raw?.__type === "pdf") {
          return {
            orgId: effectiveOrgId,
            batchId: batch.id,
            raw: r.raw,
            invoiceNo: r.invoiceNo ?? null,
            amount: r.amount ?? null,
            currency: r.currency ?? null,
            invoiceDate: r.invoiceDate ?? null,
          };
        }
        return {
          orgId: effectiveOrgId,
          batchId: batch.id,
          raw: r,
          ...mapInvoiceRow(r),
        };
      });
      await prisma.invoiceRow.createMany({ data });
    }

    if (kind === "payments") {
      const data = rows.map((r: any) => ({
        orgId: effectiveOrgId,
        batchId: batch.id,
        raw: r,
        ...mapPaymentRow(r),
      }));
      await prisma.paymentRow.createMany({ data });
    }

    if (kind === "price-list") {
      const data = rows.map((r: any) => ({
        orgId: effectiveOrgId,
        batchId: batch.id,
        raw: r,
        ...mapPriceRow(r),
      }));
      await prisma.priceListRow.createMany({ data });
    }

    return NextResponse.json({
      ok: true,
      batchId: batch.id,
      kind,
      filename: file.name,
      rows: rows.length,
      headersDetected,
      orgId: effectiveOrgId,
    });
  } catch (e: any) {
    return NextResponse.json(
      { error: "Internal error", message: e?.message ?? String(e) },
      { status: 500 }
    );
  }
}
